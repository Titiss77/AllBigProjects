# Bloquer l'accès aux fichiers de configuration et sensibles
<FilesMatch "^\.env|\.sql$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.h>
    Options +FollowSymlinks
    RewriteEngine On

    # Redirection HTTPS propre gérée par le serveur ou le .htaccess
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Redirection vers le dossier public si ce n'est pas déjà fait
    RewriteCond %{REQUEST_URI} !^/public/ [NC]
    RewriteRule ^([\s\S]*)$ public/$1 [L]
</IfModule>

# Options de performance (GZIP et Cache)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>